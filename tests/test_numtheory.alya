# Number theory tests (hand-verified ground truth)
import "std/test"
import "../src/lib.alya" as math

# Element-wise array equality (str() on arrays prints addresses).
function arr_eq(a, b) -> int
    if len(a) != len(b)
        return 0
    end
    let i = 0
    while i < len(a)
        if a[i] != b[i]
            return 0
        end
        i += 1
    end
    return 1
end

@cfg(feature = "numtheory")
function main()
    test_suite("NumTheory Tests")
    let r = runner_new()

    runner_assert_eq(r, math::isqrt(0), 0, "isqrt 0")
    runner_assert_eq(r, math::isqrt(1), 1, "isqrt 1")
    runner_assert_eq(r, math::isqrt(17), 4, "isqrt 17")
    runner_assert_eq(r, math::isqrt(1000000), 1000, "isqrt 10^6")
    @cfg(not(arch = "x86"))
    runner_assert_eq(r, math::isqrt(9223372036854775807), 3037000499, "isqrt max-int")

    let e = math::xgcd(240, 46)
    runner_assert_eq(r, e["g"], 2, "xgcd gcd")
    runner_assert_eq(r, 240 * e["x"] + 46 * e["y"], 2, "xgcd bezout")
    let e0 = math::xgcd(17, 5)
    runner_assert_eq(r, 17 * e0["x"] + 5 * e0["y"], e0["g"], "xgcd bezout 2")

    runner_assert_eq(r, math::mulmod(123456789, 987654321, 1000000007), 259106859, "mulmod ground truth")
    @cfg(not(arch = "x86"))
    runner_assert_eq(r, math::mulmod(9223372036854775807, 9223372036854775807, 1000000007), 737564071, "mulmod overflow-safe")
    runner_assert_eq(r, math::powmod(7, 100, 101), 1, "powmod fermat")
    runner_assert_eq(r, math::powmod(3, 0, 5), 1, "powmod zero exp")
    runner_assert_eq(r, math::powmod(5, 3, 1), 0, "powmod mod one")

    runner_assert_eq(r, math::modinv(3, 11), 4, "modinv 3/11")
    runner_assert_eq(r, math::modinv(10, 17), 12, "modinv 10/17")
    runner_assert_eq(r, math::modinv(6, 9), -1, "modinv no inverse")

    runner_assert_eq(r, arr_eq(math::factor(60), [2, 2, 3, 5]), 1, "factor 60")
    runner_assert_eq(r, arr_eq(math::factor(999983), [999983]), 1, "factor prime")
    runner_assert_eq(r, arr_eq(math::factor(1024), [2, 2, 2, 2, 2, 2, 2, 2, 2, 2]), 1, "factor power of two")

    runner_assert_eq(r, math::totient(1), 1, "totient 1")
    runner_assert_eq(r, math::totient(9), 6, "totient 9")
    runner_assert_eq(r, math::totient(36), 12, "totient 36")
    runner_assert_eq(r, math::totient(997), 996, "totient prime")

    runner_assert_eq(r, math::bit_len(0), 0, "bit_len zero")
    runner_assert_eq(r, math::bit_len(1), 1, "bit_len one")
    runner_assert_eq(r, math::bit_len(255), 8, "bit_len 255")
    runner_assert_eq(r, math::bit_len(256), 9, "bit_len 256")

    runner_assert_eq(r, math::popcount(0), 0, "popcount zero")
    runner_assert_eq(r, math::popcount(45), 4, "popcount 45")
    runner_assert_eq(r, math::popcount(255), 8, "popcount 255")

    runner_assert_eq(r, math::is_pow2(0), 0, "is_pow2 zero")
    runner_assert_eq(r, math::is_pow2(1), 1, "is_pow2 one")
    runner_assert_eq(r, math::is_pow2(64), 1, "is_pow2 64")
    runner_assert_eq(r, math::is_pow2(100), 0, "is_pow2 100")

    runner_assert_eq(r, math::next_pow2(0), 1, "next_pow2 zero")
    runner_assert_eq(r, math::next_pow2(5), 8, "next_pow2 five")
    runner_assert_eq(r, math::next_pow2(16), 16, "next_pow2 exact")

    let crt1 = math::crt(2, 3, 3, 5)
    runner_assert_eq(r, crt1["ok"], 1, "crt coprime ok")
    runner_assert_eq(r, crt1["x"], 8, "crt coprime x")
    runner_assert_eq(r, crt1["m"], 15, "crt coprime m")
    let crt2 = math::crt(2, 4, 6, 8)
    runner_assert_eq(r, crt2["ok"], 1, "crt compatible ok")
    runner_assert_eq(r, crt2["x"], 6, "crt compatible x")
    runner_assert_eq(r, crt2["m"], 8, "crt compatible m")
    let crt3 = math::crt(1, 2, 0, 4)
    runner_assert_eq(r, crt3["ok"], 0, "crt incompatible")

    # bigint extensions
    runner_assert_eq(r, arr_eq(math::bi_to_bytes(math::bi_gcd([48], [18]), 1), [6]), 1, "bi_gcd small")    let g1 = math::bi_from_bytes([1, 2, 3])
    runner_assert_eq(r, math::bi_cmp(math::bi_gcd(g1, [0]), g1), 0, "bi_gcd zero")
    runner_assert_eq(r, arr_eq(math::bi_to_bytes(math::bi_pow_int([7], 5), 2), [65, 167]), 1, "bi_pow_int 7^5")
    runner_assert_eq(r, arr_eq(math::bi_pow_int([99], 0), [1]), 1, "bi_pow_int zero exp")
    runner_assert_eq(r, arr_eq(math::bi_to_bytes(math::bi_lcm([6], [8]), 1), [24]), 1, "bi_lcm small")
    runner_assert_eq(r, arr_eq(math::bi_lcm([0], [8]), [0]), 1, "bi_lcm zero")

    let failed = runner_summary(r)
    if failed > 0
        exit(1)
    end
end

# Needs the feature: register an empty suite so the file still
# compiles and passes in slim views.
@cfg(not(feature = "numtheory"))
function main()
    test_suite("NumTheory Tests (skipped without numtheory feature)")
    let r = runner_new()
    let failed = runner_summary(r)
    if failed > 0
        exit(1)
    end
end

main()
