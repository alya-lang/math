# Rational tests (reduction and field axioms)
import "std/test"
import "../src/lib.alya" as math

@cfg(feature = "rational")
function main()
    test_suite("Rational Tests")
    let r = runner_new()

    runner_assert_str_eq(r, math::rat_to_string(math::rat_from_int(6, 8)), "3/4", "reduction")
    runner_assert_str_eq(r, math::rat_to_string(math::rat_from_int(-6, 8)), "-3/4", "negative numerator")
    runner_assert_str_eq(r, math::rat_to_string(math::rat_from_int(6, -8)), "-3/4", "negative denominator")
    runner_assert_str_eq(r, math::rat_to_string(math::rat_from_int(-6, -8)), "3/4", "double negative")
    runner_assert_str_eq(r, math::rat_to_string(math::rat_from_int(0, 5)), "0", "zero")
    runner_assert_str_eq(r, math::rat_to_string(math::rat_from_int(7)), "7", "whole number")

    let half = math::rat_from_int(1, 2)
    let third = math::rat_from_int(1, 3)
    runner_assert_str_eq(r, math::rat_to_string(math::rat_add(half, third)), "5/6", "add")
    runner_assert_str_eq(r, math::rat_to_string(math::rat_sub(half, third)), "1/6", "sub")
    runner_assert_str_eq(r, math::rat_to_string(math::rat_mul(half, third)), "1/6", "mul")
    runner_assert_str_eq(r, math::rat_to_string(math::rat_div(half, third)), "3/2", "div")
    runner_assert_str_eq(r, math::rat_to_string(math::rat_neg(third)), "-1/3", "neg")

    runner_assert_eq(r, math::rat_cmp(half, third), 1, "cmp greater")
    runner_assert_eq(r, math::rat_cmp(third, half), -1, "cmp less")
    runner_assert_eq(r, math::rat_cmp(half, math::rat_from_int(2, 4)), 0, "cmp equal reduced")
    runner_assert_eq(r, math::rat_cmp(math::rat_neg(half), half), -1, "cmp sign")

    runner_assert_eq(r, math::rat_is_zero(math::rat_from_int(0)), 1, "is_zero")
    runner_assert_eq(r, math::rat_is_one(math::rat_from_int(4, 4)), 1, "is_one reduced")
    runner_assert_str_eq(r, math::rat_to_string(math::rat_inv(math::rat_from_int(2, 3))), "3/2", "inv")

    # Harmonic sum H(10) = 7381/2520.
    let h = math::rat_from_int(0)
    let k = 1
    while k <= 10
        h = math::rat_add(h, math::rat_from_int(1, k))
        k += 1
    end
    runner_assert_str_eq(r, math::rat_to_string(h), "7381/2520", "harmonic sum")

    let f = math::rat_to_float(third)
    runner_assert_eq(r, f > 0.333, 1, "to_float lower")
    runner_assert_eq(r, f < 0.334, 1, "to_float upper")

    let failed = runner_summary(r)
    if failed > 0
        exit(1)
    end
end

# Needs the feature: register an empty suite so the file still
# compiles and passes in slim views.
@cfg(not(feature = "rational"))
function main()
    test_suite("Rational Tests (skipped without rational feature)")
    let r = runner_new()
    let failed = runner_summary(r)
    if failed > 0
        exit(1)
    end
end

main()
