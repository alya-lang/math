## Benchmark suite for math
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "std/bench"
import "../src/lib.alya" as math

function main()
    let runner = bench_runner("math Micro-Benchmarks")

    @cfg(feature = "bigint")
    bench_bigint(runner)

    @cfg(feature = "primes")
    bench_primes(runner)

    @cfg(feature = "matrix")
    bench_matrix(runner)
    bench_summary(runner)
end

main()

@cfg(feature = "bigint")
function bench_bigint(runner)
    # Bench 1: 2048-bit modular exponentiation (RSA core)
    let mexp_base = math::bi_from_bytes([21, 123, 205, 21])
    let mexp_mod = math::bi_sub(math::bi_shl([1], 128, 0), math::bi_from_bytes([29, 163, 17]))
    bench_start(runner, 20)
    let i = 0
    while i < 20
        math::bi_modexp_int(mexp_base, 65537, mexp_mod)
        i += 1
    end
    bench_stop(runner, "bi_modexp_int() 2048-bit 20 ops")

    # Bench 2: schoolbook multiply (112-bit operands)
    let m_a = math::bi_from_bytes([1, 142, 233, 15, 246, 195, 115, 224, 238, 78, 63, 10, 210, 50])
    let m_b = math::bi_from_bytes([1, 63, 32, 217, 194, 255, 249, 137, 211, 142, 28, 112, 203, 177])
    bench_start(runner, 2000)
    let j = 0
    while j < 2000
        math::bi_mul(m_a, m_b)
        j += 1
    end
    bench_stop(runner, "bi_mul() 112-bit 2000 ops")
end

@cfg(feature = "primes")
function bench_primes(runner)
    # Bench 3: Eratosthenes sieve to 20000
    bench_start(runner, 20)
    let k = 0
    while k < 20
        math::sieve(20000)
        k += 1
    end
    bench_stop(runner, "sieve() 20000 20 runs")
end

@cfg(feature = "matrix")
function bench_matrix(runner)
    # Bench 4: 10x10 matrix product
    let mm = math::mat(10, 10)
    bench_start(runner, 100)
    let q = 0
    while q < 100
        math::mat_mul(mm, mm)
        q += 1
    end
    bench_stop(runner, "mat_mul() 10x10 100 ops")
end
