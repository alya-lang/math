## # Integer Number Theory (64-bit domain)
##
## Part of the Alya Language package ecosystem (https://github.com/alya-lang).
## Exact integer square roots, extended GCD, overflow-safe modular
## arithmetic, Euler totients, and trial-division factorization. Inputs are
## non-negative unless noted; `0` moduli and negative roots throw.

## Integer square root (floor of sqrt).
##
## Bit-by-bit binary method: overflow-free for the full int64 range.
##
## ### Parameters
## - `n`: Non-negative integer.
##
## ### Returns
## Largest `r` with `r*r <= n`.
pub function isqrt(n: int) -> int
    if n < 0
        throw "isqrt of negative number"
    end
    let num = n
    let res = 0
    let bit = bit_shl(1, 62)
    while bit > num
        bit = bit_shr(bit, 2)
    end
    while bit != 0
        if num >= res + bit
            num = num - res - bit
            res = bit_shr(res, 1) + bit
        else
            res = bit_shr(res, 1)
        end
        bit = bit_shr(bit, 2)
    end
    return res
end

## Extended Euclidean algorithm.
##
## ### Parameters
## - `a`: First non-negative integer.
## - `b`: Second non-negative integer.
##
## ### Returns
## Map with `g` (gcd) and Bezout coefficients `x`, `y`
## (`a*x + b*y == g`).
pub function xgcd(a: int, b: int) -> map
    let old_r = a
    let r = b
    let old_s = 1
    let s = 0
    let old_t = 0
    let t = 1
    while r != 0
        let q = old_r / r
        let tmp = r
        r = old_r - q * r
        old_r = tmp
        tmp = s
        s = old_s - q * s
        old_s = tmp
        tmp = t
        t = old_t - q * t
        old_t = tmp
    end
    return { "g": old_r, "x": old_s, "y": old_t }
end

## Overflow-safe modular multiplication (double-and-add).
##
## ### Parameters
## - `a`: First factor (reduced mod `m` internally).
## - `b`: Second factor (non-negative).
## - `m`: Positive modulus.
##
## ### Returns
## `(a*b) mod m` without 64-bit overflow.
pub function mulmod(a: int, b: int, m: int) -> int
    if m <= 0
        throw "mulmod needs a positive modulus"
    end
    let x = a % m
    if x < 0
        x += m
    end
    let y = b
    let res = 0
    while y > 0
        if bit_and(y, 1) != 0
            res += x
            if res >= m
                res -= m
            end
        end
        x += x
        if x >= m
            x -= m
        end
        y = bit_shr(y, 1)
    end
    return res
end

## Modular exponentiation for non-negative int exponents.
##
## ### Parameters
## - `base`: Base integer.
## - `exp`: Non-negative exponent.
## - `m`: Positive modulus.
##
## ### Returns
## `(base^exp) mod m` (`0` when `m == 1`).
pub function powmod(base: int, exp: int, m: int) -> int
    if m <= 0
        throw "powmod needs a positive modulus"
    end
    if exp < 0
        throw "negative exponent not supported"
    end
    let b = base % m
    if b < 0
        b += m
    end
    let res = 1 % m
    let e = exp
    while e > 0
        if bit_and(e, 1) != 0
            res = mulmod(res, b, m)
        end
        e = bit_shr(e, 1)
        if e > 0
            b = mulmod(b, b, m)
        end
    end
    return res
end

## Modular multiplicative inverse.
##
## ### Parameters
## - `a`: Value to invert.
## - `m`: Positive modulus.
##
## ### Returns
## `x` with `(a*x) mod m == 1`, or -1 when `gcd(a, m) != 1`.
pub function modinv(a: int, m: int) -> int
    if m <= 0
        throw "modinv needs a positive modulus"
    end
    let e = xgcd(a, m)
    if e["g"] != 1 and e["g"] != -1
        return -1
    end
    let x = e["x"] % m
    if x < 0
        x += m
    end
    return x
end

## Bit length of a non-negative int (`0` for `0`).
##
## ### Parameters
## - `n`: Non-negative integer.
##
## ### Returns
## Position of the highest set bit (1-based).
pub function bit_len(n: int) -> int
    if n < 0
        throw "bit_len of negative number"
    end
    let b = 0
    let x = n
    while x > 0
        b += 1
        x = bit_shr(x, 1)
    end
    return b
end

## Population count: number of set bits (non-negative input).
##
## ### Parameters
## - `n`: Non-negative integer.
##
## ### Returns
## Count of `1` bits.
pub function popcount(n: int) -> int
    if n < 0
        throw "popcount of negative number"
    end
    let c = 0
    let x = n
    while x != 0
        c += bit_and(x, 1)
        x = bit_shr(x, 1)
    end
    return c
end

## Tests whether `n` is a positive power of two.
##
## ### Returns
## `1` for `1, 2, 4, ...`, else `0`.
pub function is_pow2(n: int) -> int
    if n <= 0
        return false
    end
    if bit_and(n, n - 1) == 0
        return true
    end
    return false
end

## Smallest power of two at or above `n` (`1` for `n <= 1`).
##
## ### Parameters
## - `n`: Non-negative integer (result must fit int64).
##
## ### Returns
## `2^ceil(log2(n))`.
pub function next_pow2(n: int) -> int
    if n < 0
        throw "next_pow2 of negative number"
    end
    if n <= 1
        return 1
    end
    let p = 1
    while p < n
        p = bit_shl(p, 1)
        if p <= 0
            throw "next power of two overflows"
        end
    end
    return p
end

## Positive modulo (result in `0..m-1`, overflow-free).
function _pmod(v: int, m: int) -> int
    let r = v % m
    if r < 0
        r += m
    end
    return r
end

## Chinese Remainder for two congruences.
##
## Solves `x = a1 (mod m1)`, `x = a2 (mod m2)` via Garner with
## overflow-safe modular arithmetic (`m1*m2` must fit int64).
##
## ### Parameters
## - `a1`: First residue (normalized mod `m1` internally).
## - `m1`: First positive modulus.
## - `a2`: Second residue (normalized mod `m2` internally).
## - `m2`: Second positive modulus.
##
## ### Returns
## Map with `ok` (1/0), least non-negative `x`, and combined `m`.
pub function crt(a1: int, m1: int, a2: int, m2: int) -> map
    let fail = { "ok": false, "x": 0, "m": 0 }
    if m1 <= 0 or m2 <= 0
        throw "crt needs positive moduli"
    end
    let maxint = bit_shl(1, 62) + (bit_shl(1, 62) - 1)
    let e = xgcd(m1, m2)
    let g = e["g"]
    let n1 = _pmod(a1, m1)
    let n2 = _pmod(a2, m2)
    if _pmod(n1, g) != _pmod(n2, g)
        return fail
    end
    let m2g = m2 / g
    if m1 / g > maxint / m2
        throw "crt moduli product overflows"
    end
    let lcm = m1 / g * m2
    let inv = _pmod(e["x"], m2g)
    let t = mulmod(_pmod((n2 - n1) / g, m2g), inv, m2g)
    let step = mulmod(m1, t, lcm)
    let x = 0
    if n1 >= lcm - step
        x = n1 - (lcm - step)
    else
        x = n1 + step
    end
    return { "ok": true, "x": x, "m": lcm }
end
