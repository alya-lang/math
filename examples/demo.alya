## math package demo
## Part of the Alya Language package ecosystem (https://github.com/alya-lang)

import "../src/lib.alya" as math

function main()
    say "--- 1. Representation contract ---"
    say "limb bits: " + str(math::limb_bits())

    say "--- 2. Add / sub roundtrip ---"
    let a = math::bi_from_bytes([0, 48, 57])
    let b = math::bi_from_bytes([255, 255, 255, 255])
    say "cmp(a, b): " + str(math::bi_cmp(a, b))
    say "sub/add inverse: " + str(math::bi_cmp(math::bi_add(math::bi_sub(b, a), a), b))

    say "--- 3. Modular exponentiation ---"
    let base = math::bi_from_bytes([7, 91, 205, 21])
    let mod = math::bi_sub(math::bi_shl([1], 32, 0), math::bi_from_bytes([29, 163, 17]))
    say "modexp limbs: " + str(len(math::bi_modexp_int(base, 65537, mod)))
    say "Done!"
end

main()
